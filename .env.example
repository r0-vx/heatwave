# Local persistence. The default keeps the upgraded Mumbai dataset separate
# from the earlier Ahmedabad prototype database.
DATABASE_URL=sqlite:///./heatshield_ops.db
# PostgreSQL/PostGIS alternative:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/heatwave

# India-first primary provider. Without credentials the API keeps running with
# a visibly labelled Mumbai heat-event demo scenario.
WEATHER_PROVIDER=imd
IMD_API_KEY=
IMD_STATION_ID=
IMD_API_KEY_HEADER=x-api-key
IMD_API_BASE=https://api.imd.gov.in/api/v1
MOSDAC_TOKEN=
REQUEST_TIMEOUT_SECONDS=8

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_CITY=Mumbai
DEMO_STATE=Maharashtra

# Safe default: no external alert delivery.
ALERT_PROVIDER=simulation
SMS_TEST_MODE=false
TEST_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_FLOW_URL=https://api.msg91.com/api/v5/flow/
